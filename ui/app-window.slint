import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox, ScrollView, ComboBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "assfonts - ASS Font Utility";
    min-width: 640px;
    min-height: 520px;
    background: #1a1a2e;

    // Input state
    in-out property <string> input-paths: "";
    in-out property <string> font-paths: "";
    in-out property <string> output-path: ".";
    in-out property <string> db-path: ".";
    
    // Options state
    in-out property <bool> strict-mode: true;
    in-out property <bool> allow-missing-sample: false;
    in-out property <bool> allow-missing-fonts: false;
    in-out property <bool> generate-report: false;
    in-out property <bool> force-overwrite: false;
    
    // Execution state
    in-out property <bool> is-running: false;
    in-out property <float> progress: 0;
    in-out property <string> status-text: "Ready";
    in-out property <string> log-text: "";

    // Callbacks
    callback browse-input();
    callback browse-input-folders();
    callback browse-fonts();
    callback browse-output();
    callback browse-db();
    callback run-process();
    callback stop-process();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Title
        Text {
            text: "assfonts";
            font-size: 24px;
            font-weight: 700;
            color: #e94560;
            horizontal-alignment: center;
        }

        Text {
            text: "ASS Font Subsetting & Embedding Tool";
            font-size: 12px;
            color: #a0a0a0;
            horizontal-alignment: center;
        }

        // Input Section
        Rectangle {
            border-radius: 8px;
            background: #16213e;
            border-width: 1px;
            border-color: #0f3460;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Input Files";
                    font-size: 14px;
                    font-weight: 600;
                    color: #e94560;
                }

                HorizontalBox {
                    spacing: 8px;

                    LineEdit {
                        text <=> root.input-paths;
                        placeholder-text: "Enter ASS file or directory paths (use | to separate)";
                        font-size: 12px;
                    }

                    Button {
                        text: "Files";
                        width: 60px;
                        enabled: !root.is-running;
                        clicked => { root.browse-input(); }
                    }

                    Button {
                        text: "Folders";
                        width: 60px;
                        enabled: !root.is-running;
                        clicked => { root.browse-input-folders(); }
                    }
                }
            }
        }

        // Font Paths Section
        Rectangle {
            border-radius: 8px;
            background: #16213e;
            border-width: 1px;
            border-color: #0f3460;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Font Directories";
                    font-size: 14px;
                    font-weight: 600;
                    color: #e94560;
                }

                HorizontalBox {
                    spacing: 8px;

                    LineEdit {
                        text <=> root.font-paths;
                        placeholder-text: "Font directories (use | to separate, optional if using database)";
                        font-size: 12px;
                    }

                    Button {
                        text: "Browse";
                        width: 80px;
                        enabled: !root.is-running;
                        clicked => { root.browse-fonts(); }
                    }
                }
            }
        }

        // Output Settings
        Rectangle {
            border-radius: 8px;
            background: #16213e;
            border-width: 1px;
            border-color: #0f3460;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Output Settings";
                    font-size: 14px;
                    font-weight: 600;
                    color: #e94560;
                }

                HorizontalBox {
                    spacing: 8px;

                    Text {
                        text: "Output:";
                        width: 60px;
                        color: #c0c0c0;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        text <=> root.output-path;
                        placeholder-text: "Output directory";
                        font-size: 12px;
                    }

                    Button {
                        text: "Browse";
                        width: 80px;
                        enabled: !root.is-running;
                        clicked => { root.browse-output(); }
                    }
                }

                HorizontalBox {
                    spacing: 8px;

                    Text {
                        text: "Database:";
                        width: 60px;
                        color: #c0c0c0;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        text <=> root.db-path;
                        placeholder-text: "Directory containing fonts.index.json";
                        font-size: 12px;
                    }

                    Button {
                        text: "Browse";
                        width: 80px;
                        enabled: !root.is-running;
                        clicked => { root.browse-db(); }
                    }
                }
            }
        }

        // Options Section
        Rectangle {
            border-radius: 8px;
            background: #16213e;
            border-width: 1px;
            border-color: #0f3460;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "Options";
                    font-size: 14px;
                    font-weight: 600;
                    color: #e94560;
                }

                HorizontalBox {
                    spacing: 16px;

                    CheckBox {
                        text: "Strict Mode";
                        checked <=> root.strict-mode;
                        enabled: !root.is-running;
                    }

                    CheckBox {
                        text: "Allow Missing Samples";
                        checked <=> root.allow-missing-sample;
                        enabled: !root.is-running;
                    }

                    CheckBox {
                        text: "Allow Missing Fonts";
                        checked <=> root.allow-missing-fonts;
                        enabled: !root.is-running;
                    }
                }

                HorizontalBox {
                    spacing: 16px;

                    CheckBox {
                        text: "Generate Report";
                        checked <=> root.generate-report;
                        enabled: !root.is-running;
                    }

                    CheckBox {
                        text: "Force Overwrite";
                        checked <=> root.force-overwrite;
                        enabled: !root.is-running;
                    }
                }
            }
        }

        // Status and Progress
        Rectangle {
            border-radius: 8px;
            background: #16213e;
            border-width: 1px;
            border-color: #0f3460;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                HorizontalBox {
                    Text {
                        text: "Status:";
                        color: #c0c0c0;
                    }
                    Text {
                        text: root.status-text;
                        color: root.is-running ? #4ade80 : #e94560;
                    }
                }

                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: #0f3460;

                    Rectangle {
                        x: 0;
                        width: parent.width * root.progress;
                        height: parent.height;
                        border-radius: 4px;
                        background: root.is-running ? #e94560 : #4ade80;
                    }
                }
            }
        }

        // Log Output
        Rectangle {
            border-radius: 8px;
            background: #0f0f1a;
            border-width: 1px;
            border-color: #0f3460;

            ScrollView {
                viewport-width: parent.width - 24px;
                viewport-height: parent.height - 24px;

                Text {
                    x: 12px;
                    y: 12px;
                    text: root.log-text != "" ? root.log-text : "Log output will appear here...";
                    font-size: 11px;
                    color: #808080;
                    wrap: word-wrap;
                }
            }
        }

        // Action Buttons
        HorizontalBox {
            spacing: 12px;

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: root.is-running ? "Stop" : "Run";
                width: 120px;
                primary: true;
                clicked => {
                    if (root.is-running) {
                        root.stop-process();
                    } else {
                        root.run-process();
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }
    }
}
