import {
    Button,
    VerticalBox,
    HorizontalBox,
    LineEdit,
    CheckBox,
    ScrollView,
} from "std-widgets.slint";

// Modern compact color palette
export global Theme {
    out property <color> bg-primary: #f8fafc;
    out property <color> bg-secondary: #f1f5f9;
    out property <color> bg-card: #ffffff;
    out property <color> bg-input: #f1f5f9;
    
    out property <color> accent-primary: #6366f1;
    out property <color> accent-secondary: #8b5cf6;
    out property <color> accent-success: #10b981;
    out property <color> accent-warning: #f59e0b;
    
    out property <color> text-primary: #0f172a;
    out property <color> text-secondary: #475569;
    out property <color> text-muted: #94a3b8;
    
    out property <color> border: #e2e8f0;
    out property <color> shadow: #64748b;
}

// Compact input field
export component InputField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> has-value: value != "";
    
    horizontal-stretch: 1;
    height: 32px;
    border-radius: 6px;
    background: Theme.bg-input;
    border-width: 1px;
    border-color: Theme.border;
    
    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: has-value ? value : placeholder;
            font-size: 12px;
            color: has-value ? Theme.text-primary : Theme.text-muted;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// Compact button
export component Btn inherits Rectangle {
    in property <string> text: "Button";
    in property <bool> primary: false;
    in property <bool> disabled: false;
    callback clicked();
    
    min-width: 60px;
    height: 32px;
    border-radius: 6px;
    background: primary ? Theme.accent-primary : (touch.has-hover ? Theme.bg-secondary : Theme.bg-card);
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    
    // Shadow for primary
    Rectangle {
        visible: primary && !disabled;
        y: 2px;
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        background: Theme.accent-primary;
        opacity: 0.25;
    }
    
    Text {
        text: root.text;
        color: disabled ? Theme.text-muted : (primary ? #ffffff : Theme.text-secondary);
        font-size: 12px;
        font-weight: primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    touch := TouchArea {
        enabled: !disabled;
        clicked => { root.clicked(); }
    }
}

// Compact checkbox
export component Check inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: checked ? Theme.accent-primary : Theme.bg-secondary;
    border-width: 1px;
    border-color: checked ? Theme.accent-primary : Theme.border;
    
    Text {
        text: "✓";
        color: #ffffff;
        font-size: 10px;
        visible: checked;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    TouchArea { clicked => { checked = !checked; } }
}

// Progress bar
export component Progress inherits Rectangle {
    in property <float> value: 0;
    in property <color> bar-color: Theme.accent-primary;
    
    height: 4px;
    border-radius: 2px;
    background: Theme.border;
    
    Rectangle {
        width: parent.width * value;
        height: parent.height;
        border-radius: 2px;
        background: bar-color;
    }
}

export component AppWindow inherits Window {
    title: "assfonts";
    min-width: 520px;
    min-height: 420px;
    background: Theme.bg-primary;

    in-out property <string> input-paths: "";
    in-out property <string> font-paths: "";
    in-out property <string> output-path: ".";
    in-out property <string> db-path: ".";
    in-out property <bool> strict-mode: true;
    in-out property <bool> allow-missing-sample: false;
    in-out property <bool> allow-missing-fonts: false;
    in-out property <bool> generate-report: false;
    in-out property <bool> force-overwrite: false;
    in-out property <bool> is-running: false;
    in-out property <float> progress: 0;
    in-out property <string> status-text: "Ready";
    in-out property <string> log-text: "";

    callback browse-input();
    callback browse-input-folders();
    callback browse-fonts();
    callback browse-output();
    callback browse-db();
    callback run-process();
    callback stop-process();

    ScrollView {
        viewport-width: self.visible-width;
        
        VerticalBox {
            width: parent.visible-width;
            padding: 16px;
            spacing: 12px;

            // Header
            HorizontalBox {
                spacing: 8px;
                Text {
                    text: "assfonts";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: "ASS Font Subsetting & Embedding";
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }

            // Main card
            Rectangle {
                border-radius: 10px;
                background: Theme.bg-card;
                border-width: 1px;
                border-color: Theme.border;
                
                // Shadow
                Rectangle {
                    y: 2px;
                    width: parent.width;
                    height: parent.height;
                    border-radius: 10px;
                    background: Theme.shadow;
                    opacity: 0.06;
                }
                
                VerticalBox {
                    padding: 14px;
                    spacing: 12px;

                    // Input Files
                    VerticalBox {
                        spacing: 6px;
                        Text {
                            text: "Input Files";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        HorizontalBox {
                            spacing: 6px;
                            InputField {
                                value: root.input-paths;
                                placeholder: "ASS files or directories (use | to separate)";
                                has-value: root.input-paths != "";
                            }
                            Btn {
                                text: "Files";
                                disabled: root.is-running;
                                clicked => { root.browse-input(); }
                            }
                            Btn {
                                text: "Folders";
                                disabled: root.is-running;
                                clicked => { root.browse-input-folders(); }
                            }
                        }
                    }

                    // Font Directories
                    VerticalBox {
                        spacing: 6px;
                        Text {
                            text: "Font Directories";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        HorizontalBox {
                            spacing: 6px;
                            InputField {
                                value: root.font-paths;
                                placeholder: "Font directories (optional if using database)";
                                has-value: root.font-paths != "";
                            }
                            Btn {
                                text: "Browse";
                                disabled: root.is-running;
                                clicked => { root.browse-fonts(); }
                            }
                        }
                    }

                    // Output & Database - side by side
                    HorizontalBox {
                        spacing: 12px;
                        
                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text {
                                text: "Output";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                            }
                            HorizontalBox {
                                spacing: 6px;
                                InputField {
                                    value: root.output-path;
                                    placeholder: "Output directory";
                                    has-value: root.output-path != ".";
                                }
                                Btn {
                                    text: "Browse";
                                    disabled: root.is-running;
                                    clicked => { root.browse-output(); }
                                }
                            }
                        }
                        
                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text {
                                text: "Database";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                            }
                            HorizontalBox {
                                spacing: 6px;
                                InputField {
                                    value: root.db-path;
                                    placeholder: "Database directory";
                                    has-value: root.db-path != ".";
                                }
                                Btn {
                                    text: "Browse";
                                    disabled: root.is-running;
                                    clicked => { root.browse-db(); }
                                }
                            }
                        }
                    }

                    // Options - compact inline
                    HorizontalBox {
                        spacing: 16px;
                        
                        HorizontalBox {
                            spacing: 6px;
                            Check { checked <=> root.strict-mode; }
                            Text {
                                text: "Strict";
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Check { checked <=> root.allow-missing-sample; }
                            Text {
                                text: "Missing Samples";
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Check { checked <=> root.allow-missing-fonts; }
                            Text {
                                text: "Missing Fonts";
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Check { checked <=> root.generate-report; }
                            Text {
                                text: "Report";
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Check { checked <=> root.force-overwrite; }
                            Text {
                                text: "Force";
                                font-size: 11px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Status bar
            Rectangle {
                border-radius: 8px;
                background: Theme.bg-card;
                border-width: 1px;
                border-color: Theme.border;
                
                HorizontalBox {
                    padding: 10px;
                    spacing: 10px;
                    
                    Text {
                        text: root.status-text;
                        font-size: 11px;
                        font-weight: 500;
                        color: root.is-running ? Theme.accent-success : Theme.text-secondary;
                    }
                    
                    Progress {
                        horizontal-stretch: 1;
                        value: root.progress;
                        bar-color: root.is-running ? Theme.accent-success : Theme.accent-primary;
                    }
                    
                    Text {
                        text: round(root.progress * 100) + "%";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        width: 32px;
                    }
                }
            }

            // Log - compact
            Rectangle {
                height: 120px;
                border-radius: 8px;
                background: Theme.bg-secondary;
                border-width: 1px;
                border-color: Theme.border;
                
                ScrollView {
                    viewport-width: parent.width - 16px;
                    viewport-height: parent.height - 16px;
                    
                    Text {
                        x: 8px;
                        y: 8px;
                        text: root.log-text != "" ? root.log-text : "Log output...";
                        font-size: 10px;
                        font-family: "monospace";
                        color: root.log-text != "" ? Theme.text-secondary : Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }

            // Run button
            HorizontalBox {
                alignment: center;
                
                Btn {
                    text: root.is-running ? "Stop" : "Run";
                    width: 120px;
                    primary: !root.is-running;
                    clicked => {
                        if (root.is-running) {
                            root.stop-process();
                        } else {
                            root.run-process();
                        }
                    }
                }
            }
        }
    }
}
